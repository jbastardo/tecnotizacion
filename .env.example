# ── Requeridas ───────────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://tecnotizar:PASSWORD@postgres:5432/tecnotizar

# ── PostgreSQL (solo si usas el docker-compose incluido) ─────────────────────
POSTGRES_DB=tecnotizar
POSTGRES_USER=tecnotizar
POSTGRES_PASSWORD=CAMBIA_ESTO

# ── Opcionales ───────────────────────────────────────────────────────────────

# Puerto en el que escucha la API (Coolify lo inyecta automáticamente)
PORT=3000

# Nivel de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
