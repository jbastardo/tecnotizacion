# ── Requeridas ───────────────────────────────────────────────────────────────

# Contraseña de PostgreSQL (usada por el servicio postgres Y generada en DATABASE_URL)
POSTGRES_PASSWORD=CAMBIA_POR_CONTRASEÑA_SEGURA

# ── Opcionales ───────────────────────────────────────────────────────────────

# URL pública de la app (para links en emails, OG tags, etc.)
NEXT_PUBLIC_APP_URL=https://tecnotizar.tutecnotienda.site

# Clave para llamadas internas entre servicios (middleware x-internal-key)
API_KEY=

# Secret para hash de contraseñas (si no se define, usa comportamiento legacy)
# IMPORTANTE: si ya hay usuarios registrados NO cambiar este valor o sus passwords quedarán inválidas
AUTH_SECRET=
