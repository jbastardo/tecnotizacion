# ============================================
# TECNOTIZACION - Coolify Environment Config
# ============================================

# Database (Coolify PostgreSQL)
# Format: postgresql://user:***@host:port/database
DATABASE_URL=postgresql://tecnotizacion:***@postgres:5432/tecnotizacion

# PostgreSQL Container Config
POSTGRES_USER=tecnotizacion
POSTGRES_PASSWORD=***
POSTGRES_DB=tecnotizacion

# App URL (change to your Coolify domain)
NEXT_PUBLIC_APP_URL=https://tecnotizacion.tudominio.com

# Node Environment
NODE_ENV=production
